      "options": [
        "2",
        "3",
        "3.5",
        "10"
      ],
      "answer": 0,
      "why": "4 fits into 14 three times (12), leaving 2. % gives that remainder."
    },
    {
      "q": "What is `1 + 2 * 3`?",
      "options": [
        "9",
        "7",
        "6",
        "5"
      ],
      "answer": 1,
      "why": "* goes first: 2 * 3 is 6, then 1 + 6 is 7."
    },
